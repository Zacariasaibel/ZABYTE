# Docker Compose reads .env; Django itself does not load this file.
# Use your real DNS name, without scheme or path. This example is not deployable.
SITE_DOMAIN=shop.example.invalid
# Generate privately with secrets.token_urlsafe(64). Never commit the result.
DJANGO_SECRET_KEY=
# Keep the file under /data, which is the persistent database volume.
DJANGO_DB_PATH=/data/db.sqlite3
# Compose derives DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS from SITE_DOMAIN.
# config.production forces DEBUG=False and secure HTTPS cookies.
# DJANGO_STATIC_ROOT=/static and DJANGO_BACKUP_DIR=/data/backups are fixed in Compose.
# Leave off until HTTPS is verified for every affected subdomain.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
